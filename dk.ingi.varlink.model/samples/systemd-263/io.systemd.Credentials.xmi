<?xml version="1.0" encoding="UTF-8"?>
<varlink:Interface xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:varlink="https://ingi.dk/varlink" name="io.systemd.Credentials">
  <documentation>APIs for encrypting and decrypting service credentials.</documentation>
  <members xsi:type="varlink:EnumDefinition" name="Scope">
    <documentation>The intended scope for the credential.</documentation>
    <body>
      <values name="system">
        <documentation>Generate a system-bound credential</documentation>
      </values>
      <values name="user">
        <documentation>Generate a system and user bound credential</documentation>
      </values>
    </body>
  </members>
  <members xsi:type="varlink:EnumDefinition" name="WithKey">
    <documentation>Selects the key(s) to encrypt the credentials with.</documentation>
    <body>
      <values name="auto">
        <documentation>Automatically pick the key to bind the credential to</documentation>
      </values>
      <values name="auto_initrd">
        <documentation>Automatically pick the key to bind the credential to, but ensure it is accessible in the initrd, thus potentially leaving it unencrypted.</documentation>
      </values>
      <values name="host">
        <documentation>Bind to the host key only, i.e. not the TPM</documentation>
      </values>
      <values name="tpm2">
        <documentation>Bind to the TPM only, not the host key</documentation>
      </values>
      <values name="tpm2_with_public_key">
        <documentation>Bind to the TPM only (using a public key identifying the UKI), not the host key</documentation>
      </values>
      <values name="host_tpm2">
        <documentation>Bind to both the TPM and the host key</documentation>
      </values>
      <values name="host_tpm2_with_public_key">
        <documentation>Bind to both the TPM (using a public key identifying the UKI) and the host key</documentation>
      </values>
      <values name="null">
        <documentation>Do not bind to either host key nor the TPM, thus using null encryption (this provides no authenticity nor confidentiality guarantees)</documentation>
      </values>
    </body>
  </members>
  <members xsi:type="varlink:Method" name="Encrypt">
    <documentation>Encrypts some plaintext data, returns an encrypted credential.</documentation>
    <input>
      <fields name="name">
        <documentation>The name for the encrypted credential, a string suitable for inclusion in a file name. If not specified no name is encoded in the credential. Typically, if this credential is stored on disk, this is how the file should be called, and permits authentication of the filename.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="text">
        <documentation>Plaintext to encrypt. Suitable only for textual data. Either this field or 'data' (below) must be provided.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="data">
        <documentation>Plaintext to encrypt, encoded in Base64. Suitable for binary data. Either this field or 'text' (above) must be provided.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="timestamp">
        <documentation>Timestamp to store in the credential. In µs since the UNIX epoch, i.e. Jan 1st 1970. If not specified the current time is used.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="notAfter">
        <documentation>Timestamp when to the credential should be considered invalid. In µs since the UNIX epoch. If not specified, the credential remains valid forever.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="scope">
        <documentation>The intended scope for the credential. One of 'system' or 'user'. If not specified defaults to 'system', unless an uid is specified (see below), in which case it default to 'user'.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="Scope" definition="//@members[name='Scope']" nullable="true"/>
      </fields>
      <fields name="withKey">
        <documentation>Selects the type of key to encrypt this with</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="WithKey" definition="//@members[name='WithKey']" nullable="true"/>
      </fields>
      <fields name="uid">
        <documentation>The numeric UNIX UID of the user the credential shall be scoped to. Only relevant if 'user' scope is selected (see above). If not specified and 'user' scope is selected defaults to the UID of the calling user, if that can be determined.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="allowInteractiveAuthentication">
        <documentation>Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
    </input>
    <output>
      <fields name="blob">
        <documentation>Encrypted credential in Base64 encoding. This can be stored in a credential file, for consumption in LoadEncryptedCredential= and similar calls. Note that the Base64 encoding should be retained when copied into a file.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
    </output>
  </members>
  <members xsi:type="varlink:Method" name="Decrypt">
    <documentation>Decrypts an encrypted credential, returns plaintext data.</documentation>
    <input>
      <fields name="name">
        <documentation>The name of the encrypted credential. Must the same string specified when the credential was encrypted, in order to authenticate this. If not specified authentication of the credential name is not done.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="blob">
        <documentation>The encrypted credential in Base64 encoding. This corresponds of the 'blob' field returned by the 'Encrypt' method.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="timestamp">
        <documentation>The timestamp to use when validating the credential's time validity range. If not specified the current time is used.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="scope">
        <documentation>The scope for this credential. If not specified no restrictions on the credential scope are made.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="Scope" definition="//@members[name='Scope']" nullable="true"/>
      </fields>
      <fields name="uid">
        <documentation>If the 'user' scope is selected, specifies the numeric UNIX UID of the user the credential is associated with. If not specified this is automatically derived from the UID of the calling user, if that can be determined.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="allowNull">
        <documentation>If true allows decryption of credentials encrypted with the null key, if false does not allow it, if unset/null the default depends on whether a TPM device exists and SecureBoot is enabled.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="allowInteractiveAuthentication">
        <documentation>Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
    </input>
    <output>
      <fields name="data">
        <documentation>The decrypted plaintext data in Base64 encoding.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
    </output>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="BadFormat">
    <documentation>Indicates that a corrupt and unsupported encrypted credential was provided.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NameMismatch">
    <documentation>The specified name does not match the name stored in the credential.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="TimeMismatch">
    <documentation>The credential's is no longer or not yet valid.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NoSuchUser">
    <documentation>The specified user does not exist.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="BadScope">
    <documentation>The credential does not match the selected scope.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="CantFindPCRSignature">
    <documentation>PCR signature required for decryption, but not found.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NullKeyNotAllowed">
    <documentation>The key was encrypted with a null key, but that's not allowed during decryption.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="KeyBelongsToOtherTPM">
    <documentation>The TPM integrity check for this key failed, key probably belongs to another TPM, or was corrupted.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="TPMInDictionaryLockout">
    <documentation>The TPM is in dictionary lockout mode, cannot operate.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="UnexpectedPCRState">
    <documentation>Unexpected TPM PCR state of the system.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="PCRsKeptChanging">
    <documentation>PCR values kept changing while unsealing the TPM2 secret, something on this system extends a PCR continuously.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NVIndexUnusable">
    <documentation>The NV index referenced by the key is missing, unwritten, or unusable, it could be for another system.</documentation>
    <parameters/>
  </members>
</varlink:Interface>
