<?xml version="1.0" encoding="UTF-8"?>
<varlink:Interface xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:varlink="https://ingi.dk/varlink" name="io.systemd.AskPassword">
  <documentation>An interface for interactively asking the user for a password</documentation>
  <members xsi:type="varlink:EnumDefinition" name="EchoMode">
    <documentation>Encodes whether to provide visual feedback as the password is typed in</documentation>
    <body>
      <values name="off">
        <documentation>Request that the password is prompted for without any visual feedback</documentation>
      </values>
      <values name="on">
        <documentation>Show the password in plaintext as it is typed in</documentation>
      </values>
      <values name="masked">
        <documentation>Provide visual feedback as the password is typed, but mask the password plaintext</documentation>
      </values>
    </body>
  </members>
  <members xsi:type="varlink:Method" name="Ask">
    <documentation>Interactively ask the user for a password, or answer from a previously cached entry</documentation>
    <input>
      <fields name="message">
        <documentation>The message to show when prompting for the password</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="keyname">
        <documentation>The name for the kernel keyring entry used for caching</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="icon">
        <documentation>The icon name to display, following the freedesktop.org icon naming specification</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="id">
        <documentation>An recognizable id for the password prompt</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="timeoutUSec">
        <documentation>Timeout in µs (relative, CLOCK_MONOTONIC; set to zero to only check cache and not query interactively; set to UINT64_MAX to disable relative timeout; if not set defaults to 90s)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="untilUSec">
        <documentation>Timeout in µs (absolute, CLOCK_MONOTONIC; if both timeoutUSec and untilUSec are specified the earlier of the two is used; set to zero to only check cache and not query interactively; leave unset or set to UINT64_MAX to disable absolute timeout)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="acceptCached">
        <documentation>Whether to accept cached passwords from the kernel keyring</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="pushCache">
        <documentation>Whether to push acquired passwords into the kernel keyring</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="echo">
        <documentation>Whether to give visual feedback when typing in the password</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="EchoMode" definition="//@members[name='EchoMode']" nullable="true"/>
      </fields>
      <fields name="allowInteractiveAuthentication">
        <documentation>Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
    </input>
    <output>
      <fields name="passwords">
        <documentation>List of acquired passwords. This typically contains one entry, but might contain more in case multiple passwords were previously cached.</documentation>
        <type xsi:type="varlink:ArrayType">
          <elementType xsi:type="varlink:BuiltinType" kind="string"/>
        </type>
      </fields>
    </output>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NoPasswordAvailable">
    <documentation>No password available, because none was provided in the cache, and no agent was asked</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="TimeoutReached">
    <documentation>Query timeout reached, user did not provide a password in time</documentation>
    <parameters/>
  </members>
</varlink:Interface>
