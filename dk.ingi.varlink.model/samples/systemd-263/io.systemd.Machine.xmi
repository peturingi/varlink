  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NoUIDShift">
    <documentation>Machine uses a complex UID/GID mapping, cannot determine shift</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NotAvailable">
    <documentation>Requested information is not available</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NotSupported">
    <documentation>Requested operation is not supported</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NoIPC">
    <documentation>There is no IPC service (such as system bus or varlink) in the container</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NoSuchUser">
    <documentation>No such user</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NoSuchGroup">
    <documentation>No such group</documentation>
    <parameters/>
