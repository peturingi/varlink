<?xml version="1.0" encoding="UTF-8"?>
<varlink:Interface xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:varlink="https://ingi.dk/varlink" name="io.systemd.Shutdown">
  <documentation>APIs for shutting down or rebooting the system.</documentation>
  <members xsi:type="varlink:Method" name="PowerOff">
    <documentation>Power off the system</documentation>
    <input>
      <fields name="allowInteractiveAuthentication">
        <documentation>Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="skipInhibitors">
        <documentation>Skip active inhibitors and force the operation</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
    </input>
    <output/>
  </members>
  <members xsi:type="varlink:Method" name="Reboot">
    <documentation>Reboot the system</documentation>
    <input>
      <fields name="allowInteractiveAuthentication">
        <documentation>Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="skipInhibitors">
        <documentation>Skip active inhibitors and force the operation</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
    </input>
    <output/>
  </members>
  <members xsi:type="varlink:Method" name="Halt">
    <documentation>Halt the system</documentation>
    <input>
      <fields name="allowInteractiveAuthentication">
        <documentation>Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="skipInhibitors">
        <documentation>Skip active inhibitors and force the operation</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
    </input>
    <output/>
  </members>
  <members xsi:type="varlink:Method" name="KExec">
    <documentation>Reboot the system via kexec</documentation>
    <input>
      <fields name="allowInteractiveAuthentication">
        <documentation>Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="skipInhibitors">
        <documentation>Skip active inhibitors and force the operation</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
    </input>
    <output/>
  </members>
  <members xsi:type="varlink:Method" name="SoftReboot">
    <documentation>Reboot userspace only</documentation>
    <input>
      <fields name="allowInteractiveAuthentication">
        <documentation>Controls whether interactive authentication (via polkit) shall be allowed. If unspecified defaults to false.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="skipInhibitors">
        <documentation>Skip active inhibitors and force the operation</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
    </input>
    <output/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="AlreadyInProgress">
    <documentation>Another shutdown or sleep operation is already in progress</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="BlockedByInhibitor">
    <documentation>Operation denied due to active block inhibitor</documentation>
    <parameters>
      <fields name="who">
        <documentation>Who is holding the inhibitor</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="why">
        <documentation>Why the inhibitor is held</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
    </parameters>
  </members>
</varlink:Interface>
