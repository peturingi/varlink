<?xml version="1.0" encoding="UTF-8"?>
<varlink:Interface xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:varlink="https://ingi.dk/varlink" name="io.systemd.MuteConsole">
  <documentation>API for temporarily muting noisy output to the main kernel console</documentation>
  <members xsi:type="varlink:Method" name="Mute" moreSupport="required">
    <documentation>Mute kernel and PID 1 output to the main kernel console</documentation>
    <input>
      <fields name="kernel">
        <documentation>Whether to mute the kernel's output to the console (defaults to true).</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="pid1">
        <documentation>Whether to mute PID1's output to the console (defaults to true).</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
    </input>
    <output/>
  </members>
</varlink:Interface>
