<?xml version="1.0" encoding="UTF-8"?>
<varlink:Interface xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:varlink="https://ingi.dk/varlink" name="io.systemd.Network.Link">
  <members xsi:type="varlink:EnumDefinition" name="DHCPv6ClientState">
    <body>
      <values name="stopped"/>
      <values name="information_request"/>
      <values name="solicitation"/>
      <values name="request"/>
      <values name="bound"/>
      <values name="renew"/>
      <values name="rebind"/>
      <values name="stopping"/>
    </body>
  </members>
  <members xsi:type="varlink:EnumDefinition" name="LinkState">
    <body>
      <values name="pending"/>
      <values name="initialized"/>
      <values name="configuring"/>
      <values name="configured"/>
      <values name="unmanaged"/>
      <values name="failed"/>
      <values name="linger"/>
    </body>
  </members>
  <members xsi:type="varlink:EnumDefinition" name="LinkConfiguringReason">
    <body>
      <values name="traffic_control"/>
      <values name="link_layer"/>
      <values name="activation"/>
      <values name="stacked_netdevs"/>
      <values name="static_addresses"/>
      <values name="static_address_labels"/>
      <values name="static_bridge_fdb"/>
      <values name="static_bridge_mdb"/>
      <values name="static_neighbors"/>
      <values name="static_neighbor_proxy"/>
      <values name="static_nexthops"/>
      <values name="static_routes"/>
      <values name="static_routing_policy_rules"/>
      <values name="sr_iov"/>
      <values name="bearer"/>
      <values name="ipv6ll"/>
      <values name="static_address_not_ready"/>
      <values name="dhcp4_6rd"/>
      <values name="dhcp4_6rd_prefix"/>
      <values name="dhcp6_pd"/>
      <values name="dhcp6_pd_prefix"/>
      <values name="dynamic_addressing"/>
    </body>
  </members>
  <members xsi:type="varlink:EnumDefinition" name="LinkAddressState">
    <body>
      <values name="off"/>
      <values name="degraded"/>
      <values name="routable"/>
    </body>
  </members>
  <members xsi:type="varlink:EnumDefinition" name="LinkOnlineState">
    <body>
      <values name="offline"/>
      <values name="partial"/>
      <values name="online"/>
    </body>
  </members>
  <members xsi:type="varlink:EnumDefinition" name="LinkRequiredAddressFamily">
    <body>
      <values name="any"/>
      <values name="ipv4"/>
      <values name="ipv6"/>
      <values name="both"/>
    </body>
  </members>
  <members xsi:type="varlink:StructDefinition" name="Address">
    <body>
      <fields name="Family">
        <documentation>Address family (AF_INET or AF_INET6)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="Address">
        <documentation>IP address</documentation>
        <type xsi:type="varlink:ArrayType">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="AddressString">
        <documentation>IP address (human-readable format)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="Peer">
        <documentation>Peer address for point-to-point interfaces</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="PeerString">
        <documentation>Peer address for point-to-point interfaces (human-readable format)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="PrefixLength">
        <documentation>Network prefix length</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="ConfigSource">
        <documentation>Configuration source for this address</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="ConfigProvider">
        <documentation>Address of the configuration provider (DHCP server, router, etc.)</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="ConfigProviderString">
        <documentation>Address of the configuration provider (DHCP server, router, etc.) (human-readable format)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="Broadcast">
        <documentation>Broadcast address for IPv4 networks</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="BroadcastString">
        <documentation>Broadcast address for IPv4 networks (human-readable format)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="Scope">
        <documentation>Address scope (RT_SCOPE_* value)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="ScopeString">
        <documentation>Human-readable scope string</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="Flags">
        <documentation>Address flags (IFA_F_* values)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="FlagsString">
        <documentation>Human-readable flags string</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="Label">
        <documentation>Address label for IPv4</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="PreferredLifetimeUSec">
        <documentation>Preferred lifetime in microseconds</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="PreferredLifetimeUsec">
        <documentation>Preferred lifetime in microseconds (deprecated, for backward compatibility)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="ValidLifetimeUSec">
        <documentation>Valid lifetime in microseconds</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="ValidLifetimeUsec">
        <documentation>Valid lifetime in microseconds (deprecated, for backward compatibility)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="ConfigState">
        <documentation>Configuration state of this address</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
    </body>
  </members>
  <members xsi:type="varlink:StructDefinition" name="BitRates">
    <body>
      <fields name="TxBitRate">
        <documentation>Transmit bitrate in bits per second</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="RxBitRate">
        <documentation>Receive bitrate in bits per second</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
    </body>
  </members>
  <members xsi:type="varlink:StructDefinition" name="DHCPLease">
    <body>
      <fields name="LeaseTimestampUSec">
        <documentation>Timestamp when the lease was acquired in microseconds</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="Timeout1USec">
        <documentation>T1 timeout (lease renewal time) in microseconds</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="Timeout2USec">
        <documentation>T2 timeout (lease rebinding time) in microseconds</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="Hostname">
        <documentation>Hostname received from DHCP server</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
    </body>
  </members>
  <members xsi:type="varlink:StructDefinition" name="DHCPServer">
    <body>
      <fields name="PoolOffset">
        <documentation>Offset from the network address for the DHCP address pool</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="PoolSize">
        <documentation>Size of the DHCP address pool</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="Leases">
        <documentation>Active DHCP leases assigned by the server</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:NamedTypeReference" typeName="DHCPServerLease" definition="//@members[name='DHCPServerLease']"/>
        </type>
      </fields>
      <fields name="StaticLeases">
        <documentation>Static DHCP leases configured for specific clients</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:NamedTypeReference" typeName="DHCPServerLease" definition="//@members[name='DHCPServerLease']"/>
        </type>
      </fields>
    </body>
  </members>
  <members xsi:type="varlink:StructDefinition" name="DHCPServerLease">
    <body>
      <fields name="ClientId">
        <documentation>DHCP client identifier</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="Address">
        <documentation>Address assigned to the client</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="AddressString">
        <documentation>Address assigned to the client (human-readable format)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="Hostname">
        <documentation>Hostname provided by the DHCP client</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="HardwareAddressType">
        <documentation>Hardware address type (ARPHRD_* value)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="HardwareAddressLength">
        <documentation>Length of hardware address in bytes</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="HardwareAddress">
        <documentation>Hardware (MAC) address of the DHCP client</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="ExpirationUSec">
        <documentation>Lease expiration time in monotonic microseconds</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="ExpirationRealtimeUSec">
        <documentation>Lease expiration time in realtime microseconds</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
    </body>
  </members>
  <members xsi:type="varlink:StructDefinition" name="DHCPv6Client">
    <body>
      <fields name="State">
        <documentation>State of the DHCPv6 client</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="DHCPv6ClientState" definition="//@members[name='DHCPv6ClientState']" nullable="true"/>
      </fields>
      <fields name="Lease">
        <documentation>DHCPv6 lease information including timestamps and timeouts</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="DHCPLease" definition="//@members[name='DHCPLease']" nullable="true"/>
      </fields>
      <fields name="Prefixes">
        <documentation>Delegated prefixes received from DHCPv6 server</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:NamedTypeReference" typeName="DHCPv6ClientPD" definition="//@members[name='DHCPv6ClientPD']"/>
        </type>
      </fields>
      <fields name="VendorSpecificOptions">
        <documentation>Vendor-specific options received in DHCPv6 response</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:NamedTypeReference" typeName="DHCPv6ClientVendorOption" definition="//@members[name='DHCPv6ClientVendorOption']"/>
        </type>
      </fields>
      <fields name="DUID">
        <documentation>DHCP Unique Identifier (DUID) of the client</documentation>
        <type xsi:type="varlink:ArrayType">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
    </body>
  </members>
  <members xsi:type="varlink:StructDefinition" name="DHCPv6ClientPD">
    <body>
      <fields name="Prefix">
        <documentation>Delegated IPv6 prefix</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="PrefixString">
        <documentation>Human-readable delegated IPv6 prefix</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="PrefixLength">
        <documentation>Length of the delegated prefix in bits</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="PreferredLifetimeUSec">
        <documentation>Preferred lifetime of the prefix in microseconds</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="ValidLifetimeUSec">
        <documentation>Valid lifetime of the prefix in microseconds</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
    </body>
  </members>
  <members xsi:type="varlink:StructDefinition" name="DHCPv6ClientVendorOption">
    <body>
      <fields name="EnterpriseId">
        <documentation>IANA enterprise number identifying the vendor</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="SubOptionCode">
        <documentation>Vendor-specific sub-option code</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="SubOptionData">
        <documentation>Raw data of the vendor-specific sub-option</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
    </body>
  </members>
  <members xsi:type="varlink:StructDefinition" name="DNS">
    <body>
      <fields name="Family">
        <documentation>Address family (AF_INET or AF_INET6)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="Address">
        <documentation>DNS server IP address</documentation>
        <type xsi:type="varlink:ArrayType">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="AddressString">
        <documentation>DNS server IP address (human-readable format)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="Port">
        <documentation>DNS server port number</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="InterfaceIndex">
        <documentation>Interface index for link-local DNS servers</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="ServerName">
        <documentation>DNS server hostname for DoT/DoH</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="ConfigSource">
        <documentation>Configuration source for this DNS server</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="ConfigProvider">
        <documentation>Address of the configuration provider</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="ConfigProviderString">
        <documentation>Address of the configuration provider (human-readable format)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
    </body>
  </members>
  <members xsi:type="varlink:StructDefinition" name="DNSSECNegativeTrustAnchor">
    <body>
      <fields name="DNSSECNegativeTrustAnchor">
        <documentation>Domain name for which DNSSEC validation is disabled</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="ConfigSource">
        <documentation>Configuration source for this negative trust anchor</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
    </body>
  </members>
  <members xsi:type="varlink:StructDefinition" name="DNSSetting">
    <body>
      <fields name="LLMNR">
        <documentation>Link-Local Multicast Name Resolution setting</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="MDNS">
        <documentation>Multicast DNS setting</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="DNSDefaultRoute">
        <documentation>Whether this connection can be used as a default route for DNS lookups</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="DNSOverTLS">
        <documentation>DNS-over-TLS mode setting</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="ConfigSource">
        <documentation>Configuration source for this DNS setting</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
    </body>
  </members>
  <members xsi:type="varlink:StructDefinition" name="Domain">
    <body>
      <fields name="Domain">
        <documentation>DNS search or route domain name</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="ConfigSource">
        <documentation>Configuration source for this domain</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="ConfigProvider">
        <documentation>Address of the configuration provider</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="ConfigProviderString">
        <documentation>Address of the configuration provider (human-readable format)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
    </body>
  </members>
  <members xsi:type="varlink:StructDefinition" name="Interface">
    <body>
      <fields name="Index">
        <documentation>Network interface index</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="Name">
        <documentation>Primary interface name</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="AlternativeNames">
        <documentation>Alternative interface names</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="string"/>
        </type>
      </fields>
      <fields name="MasterInterfaceIndex">
        <documentation>Interface index of the master device (for bridge/bond slaves)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="Kind">
        <documentation>Interface kind (vlan, bridge, bond, etc.)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="Type">
        <documentation>Interface type (ether, loopback, etc.)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="Driver">
        <documentation>Kernel driver name</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="Flags">
        <documentation>Interface flags (IFF_* values)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="FlagsString">
        <documentation>Human-readable interface flags</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="KernelOperationalState">
        <documentation>Kernel operational state (IF_OPER_* value)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="KernelOperationalStateString">
        <documentation>Human-readable kernel operational state</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="MTU">
        <documentation>Current MTU in bytes</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="MinimumMTU">
        <documentation>Minimum allowed MTU in bytes</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="MaximumMTU">
        <documentation>Maximum allowed MTU in bytes</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="HardwareAddress">
        <documentation>Current hardware (MAC) address</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="PermanentHardwareAddress">
        <documentation>Permanent hardware (MAC) address from factory</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="BroadcastAddress">
        <documentation>Broadcast address for Ethernet interfaces</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="IPv6LinkLocalAddress">
        <documentation>IPv6 link-local address</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="IPv6LinkLocalAddressString">
        <documentation>IPv6 link-local address (human-readable format)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="WirelessLanInterfaceType">
        <documentation>Wireless LAN interface type (NL80211_IFTYPE_* value)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="WirelessLanInterfaceTypeString">
        <documentation>Human-readable wireless LAN interface type</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="SSID">
        <documentation>Wireless network SSID</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="BSSID">
        <documentation>Wireless access point BSSID (MAC address)</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="AdministrativeState">
        <documentation>Administrative state (configuring, configured, etc.)</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="LinkState" definition="//@members[name='LinkState']"/>
      </fields>
      <fields name="ConfiguringReasons">
        <documentation>Why the link is still in the configuring state, set only in that state</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:NamedTypeReference" typeName="LinkConfiguringReason" definition="//@members[name='LinkConfiguringReason']"/>
        </type>
      </fields>
      <fields name="OperationalState">
        <documentation>Operational state (routable, degraded, etc.)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="CarrierState">
        <documentation>Carrier state (carrier, no-carrier, etc.)</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="AddressState">
        <documentation>Address configuration state</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="LinkAddressState" definition="//@members[name='LinkAddressState']"/>
      </fields>
      <fields name="IPv4AddressState">
        <documentation>IPv4 address configuration state</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="LinkAddressState" definition="//@members[name='LinkAddressState']"/>
      </fields>
      <fields name="IPv6AddressState">
        <documentation>IPv6 address configuration state</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="LinkAddressState" definition="//@members[name='LinkAddressState']"/>
      </fields>
