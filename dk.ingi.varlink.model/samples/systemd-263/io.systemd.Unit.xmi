          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="TasksCurrent">
        <documentation>The current number of tasks (i.e., processes or threads) running within the cgroup</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="EffectiveTasksMax">
        <documentation>The maximum number of tasks that the cgroup is allowed to run concurrently</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="IPIngressBytes">
        <documentation>The total number of bytes received by the cgroup's IP stack</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="IPIngressPackets">
        <documentation>The total number of incoming packets received by the cgroup's IP stack</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="IPEgressBytes">
        <documentation>iThe total number of bytes sent by the cgroup's IP stack</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
