  <members xsi:type="varlink:StructDefinition" name="UnitRuntime">
    <documentation>An object to represent a unit's runtime information</documentation>
    <body>
      <fields name="Following">
        <documentation>If not empty, the field contains the name of another unit that this unit follows in state</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="LoadState">
        <documentation>Reflects whether the configuration file of this unit has been loaded</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="ActiveState">
        <documentation>Reflects whether the unit is currently active or not</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="FreezerState">
        <documentation>Reflects whether the unit is currently frozen or not</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="SubState">
        <documentation>Reflect more fine-grained state that is unit-type-specific</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="UnitFileState">
        <documentation>Reflects the install state of the unit file</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="StateChangeTimestamp">
        <documentation>Timestamp when the firmware first began execution</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="Timestamp" definition="//@members[name='Timestamp']" nullable="true"/>
      </fields>
      <fields name="ActiveEnterTimestamp">
        <documentation>Timestamp when the unit entered active state</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="Timestamp" definition="//@members[name='Timestamp']" nullable="true"/>
      </fields>
      <fields name="ActiveExitTimestamp">
        <documentation>Timestamp when the unit exited active state</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="Timestamp" definition="//@members[name='Timestamp']" nullable="true"/>
      </fields>
      <fields name="InactiveEnterTimestamp">
        <documentation>Timestamp when the unit entered inactive state</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="Timestamp" definition="//@members[name='Timestamp']" nullable="true"/>
      </fields>
      <fields name="InactiveExitTimestamp">
        <documentation>Timestamp when the unit exited inactive state</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="Timestamp" definition="//@members[name='Timestamp']" nullable="true"/>
      </fields>
      <fields name="CanStart">
        <documentation>Reflects whether the unit can be started or not</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool"/>
      </fields>
      <fields name="CanStop">
        <documentation>Reflects whether the unit can be stopped or not</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool"/>
      </fields>
      <fields name="CanReload">
        <documentation>Reflects whether the unit can be reloaded or not</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool"/>
      </fields>
      <fields name="CanIsolate">
        <documentation>Reflects whether the unit may be started in isolation mode</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool"/>
      </fields>
      <fields name="CanClean">
        <documentation>Returns which unit resources can be cleaned up</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="string"/>
        </type>
      </fields>
      <fields name="CanFreeze">
        <documentation>Whether the unit supports the freeze operation</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool"/>
      </fields>
      <fields name="CanLiveMount">
        <documentation>Whether the unit supports live mounting</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool"/>
      </fields>
      <fields name="JobId">
        <documentation>The job ID of the job currently scheduled or being executed for this unit, if there is any.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="NeedDaemonReload">
        <documentation>Whether the configuration file this unit is loaded from (i.e. FragmentPath or SourcePath) has changed since the configuration was read and hence whether a configuration reload is recommended</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool"/>
      </fields>
      <fields name="ConditionResult">
        <documentation>Condition result of the last time the configured conditions of this unit were checked</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool"/>
      </fields>
      <fields name="AssertResult">
        <documentation>Assert result of the last time the configured asserts of this unit were checked</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool"/>
      </fields>
      <fields name="ConditionTimestamp">
        <documentation>The last time the configured conditions of the unit have been checked</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="Timestamp" definition="//@members[name='Timestamp']" nullable="true"/>
      </fields>
      <fields name="AssertTimestamp">
        <documentation>The last time the configured asserts of the unit have been checked</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="Timestamp" definition="//@members[name='Timestamp']" nullable="true"/>
      </fields>
      <fields name="InvocationID">
        <documentation>Current invocation ID</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="Markers">
        <documentation>Reflects whether the unit has been marked for reload, restart, etc.</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="string"/>
        </type>
      </fields>
      <fields name="ActivationDetails">
        <documentation>Provides details about why a unit was activated</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:NamedTypeReference" typeName="ActivationDetails" definition="//@members[name='ActivationDetails']"/>
        </type>
      </fields>
      <fields name="CGroup">
        <documentation>The cgroup runtime of the unit</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="CGroupRuntime" definition="//@members[name='CGroupRuntime']" nullable="true"/>
      </fields>
      <fields name="Automount">
        <documentation>The automount runtime of the unit</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="AutomountRuntime" definition="//@members[name='AutomountRuntime']" nullable="true"/>
      </fields>
      <fields name="Mount">
        <documentation>The mount runtime of the unit</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="MountRuntime" definition="//@members[name='MountRuntime']" nullable="true"/>
      </fields>
      <fields name="Path">
        <documentation>The path runtime of the unit</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="PathRuntime" definition="//@members[name='PathRuntime']" nullable="true"/>
      </fields>
      <fields name="Scope">
        <documentation>The scope runtime of the unit</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="ScopeRuntime" definition="//@members[name='ScopeRuntime']" nullable="true"/>
      </fields>
      <fields name="Service">
        <documentation>The service runtime of the unit</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="ServiceRuntime" definition="//@members[name='ServiceRuntime']" nullable="true"/>
      </fields>
      <fields name="Socket">
        <documentation>The socket runtime of the unit</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="SocketRuntime" definition="//@members[name='SocketRuntime']" nullable="true"/>
      </fields>
      <fields name="Swap">
        <documentation>The swap runtime of the unit</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="SwapRuntime" definition="//@members[name='SwapRuntime']" nullable="true"/>
      </fields>
      <fields name="Timer">
        <documentation>The timer runtime of the unit</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="TimerRuntime" definition="//@members[name='TimerRuntime']" nullable="true"/>
      </fields>
    </body>
