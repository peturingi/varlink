        <documentation>Memory NUMA nodes that the cgroup is allowed to use</documentation>
        <type xsi:type="varlink:ArrayType" nullable="true">
          <elementType xsi:type="varlink:BuiltinType" kind="int"/>
        </type>
      </fields>
      <fields name="CPUUsageNSec">
        <documentation>The total CPU usage time in nanoseconds (ns) for the cgroup</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
