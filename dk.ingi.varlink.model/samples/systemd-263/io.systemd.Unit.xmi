  <members xsi:type="varlink:StructDefinition" name="UnitProperties">
    <documentation>Configuration and mutable runtime state that can be changed on an existing unit</documentation>
    <body>
      <fields name="Markers">
        <documentation>Replace markers, or use '+'/'-' prefixes to add/remove them. An empty array clears all markers.</documentation>
