  <members xsi:type="varlink:Method" name="List" moreSupport="supported">
    <documentation>List units</documentation>
    <input>
      <fields name="name">
        <documentation>If non-null the name of a unit.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="pid">
        <documentation>If non-null the PID of a unit. Special value 0 means to take pid of the caller.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="ProcessId" definition="//@members[name='ProcessId']" nullable="true"/>
      </fields>
      <fields name="cgroup">
        <documentation>If non-null the cgroup of a unit</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="invocationID">
        <documentation>If non-null the invocation ID of a unit</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
    </input>
    <output>
      <fields name="context">
        <documentation>Configuration of the unit</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="UnitContext" definition="//@members[name='UnitContext']"/>
      </fields>
      <fields name="runtime">
        <documentation>Runtime information of the unit</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="UnitRuntime" definition="//@members[name='UnitRuntime']"/>
      </fields>
    </output>
  </members>
  <members xsi:type="varlink:Method" name="EnqueueJob" moreSupport="supported">
    <documentation>Enqueue jobs for one or more units</documentation>
    <input>
      <fields name="names">
        <documentation>Unit names. Jobs are enqueued atomically. Multiple names require 'more' and receive one reply per job. Merged jobs may yield fewer replies; correlate by the unit name in each job.</documentation>
        <type xsi:type="varlink:ArrayType">
          <elementType xsi:type="varlink:BuiltinType" kind="string"/>
        </type>
      </fields>
      <fields name="jobType">
        <documentation>The job type to enqueue.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="JobType" definition="//@members[name='JobType']"/>
      </fields>
      <fields name="mode">
        <documentation>Job mode. Defaults to replace.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="JobMode" definition="//@members[name='JobMode']" nullable="true"/>
      </fields>
      <fields name="notifyJobChanges">
        <documentation>If true, stream job state change notifications. Defaults to false. Requires 'more' and a single unit name.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="notifyUnitChanges">
        <documentation>If true, stream unit runtime notifications on state changes. Defaults to false. Requires 'more' and a single unit name.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
    </input>
    <output>
      <fields name="context">
        <documentation>Unit context. Set in the final reply.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="UnitContext" definition="//@members[name='UnitContext']" nullable="true"/>
      </fields>
      <fields name="runtime">
        <documentation>Unit runtime state. Set in the final reply and in intermediate streaming notifications when notifyUnitChanges is true.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="UnitRuntime" definition="//@members[name='UnitRuntime']" nullable="true"/>
      </fields>
      <fields name="job">
        <documentation>The job that was enqueued. Always set in the final streaming reply; also included in intermediate streaming notifications when notifyJobChanges is true.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="Job" definition="//@members[name='Job']" nullable="true"/>
      </fields>
    </output>
  </members>
  <members xsi:type="varlink:Method" name="SetProperties">
    <documentation>Set unit properties</documentation>
    <input>
      <fields name="name">
        <documentation>The name of the unit to operate on.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="runtime">
        <documentation>Whether to apply the change ephemerally or persistently. Currently only true is supported.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool"/>
      </fields>
      <fields name="properties">
        <documentation>The runtime properties to set.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="UnitProperties" definition="//@members[name='UnitProperties']"/>
      </fields>
    </input>
    <output/>
  </members>
  <members xsi:type="varlink:Method" name="StartTransient" moreSupport="supported">
    <documentation>Create a transient unit and start it</documentation>
    <input>
      <fields name="context">
        <documentation>Unit context. Must include ID (the unit name). Only the subset of fields settable at creation time is accepted; supplying any other field returns PropertyNotSupported.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="UnitContext" definition="//@members[name='UnitContext']"/>
      </fields>
      <fields name="mode">
        <documentation>Job mode. Defaults to replace.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="JobMode" definition="//@members[name='JobMode']" nullable="true"/>
      </fields>
      <fields name="notifyJobChanges">
        <documentation>If true and 'more' is set, stream job state change notifications. Defaults to false.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="notifyUnitChanges">
        <documentation>If true and 'more' is set, stream unit runtime notifications on state changes. Defaults to false.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
    </input>
    <output>
      <fields name="context">
        <documentation>Unit context. Set in the final reply.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="UnitContext" definition="//@members[name='UnitContext']" nullable="true"/>
      </fields>
      <fields name="runtime">
        <documentation>Unit runtime state. Set in the final reply and in intermediate streaming notifications when notifyUnitChanges is true.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="UnitRuntime" definition="//@members[name='UnitRuntime']" nullable="true"/>
      </fields>
      <fields name="job">
        <documentation>The job that was enqueued. Always set in the final streaming reply; also included in intermediate streaming notifications when notifyJobChanges is true.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="Job" definition="//@members[name='Job']" nullable="true"/>
      </fields>
    </output>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NoSuchUnit">
    <documentation>No matching unit found</documentation>
    <parameters>
      <fields name="parameter">
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
    </parameters>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="UnitMasked">
    <documentation>The unit is masked</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="UnitError">
    <documentation>Unit is in a fatal error state</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="PropertyNotSupported">
    <documentation>The named property cannot be set (via SetProperties() or at creation time via StartTransient())</documentation>
    <parameters>
      <fields name="property">
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
    </parameters>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="OnlyByDependency">
    <documentation>Job for the unit may only be enqueued by dependencies</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="DBusShuttingDown">
    <documentation>A unit that requires D-Bus cannot be started as D-Bus is shutting down</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="UnitExists">
    <documentation>A unit with this name already exists</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="UnitTypeNotSupported">
    <documentation>This unit type does not support transient units</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="BadUnitSetting">
    <documentation>The unit file content contains invalid settings</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="AlreadyBeingWatched">
    <documentation>The job or unit is already being watched by another streaming connection</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="ProcessIdUnknown">
    <documentation>The specified process could not be found</documentation>
    <parameters/>
  </members>
</varlink:Interface>
