        <documentation>The peak amount of swap space used by the cgroup since its creation, in bytes</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="MemoryZSwapCurrent">
        <documentation>The current amount of zswap space used by the cgroup, in bytes</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="MemoryAvailable">
        <documentation>The available memory for the cgroup, in bytes.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="EffectiveMemoryMax">
        <documentation>The effective maximum amount of memory allowed for the cgroup, in bytes</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="EffectiveMemoryHigh">
        <documentation>The effective high watermark for memory usage by the cgroup, in bytes</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
