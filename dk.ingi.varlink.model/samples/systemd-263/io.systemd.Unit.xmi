        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="MemoryPeak">
        <documentation>The peak amount of memory used by the cgroup since its creation, in bytes</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="MemorySwapCurrent">
        <documentation>The current amount of swap space used by the cgroup, in bytes</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
