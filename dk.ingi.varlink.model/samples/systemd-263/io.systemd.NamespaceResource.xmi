<?xml version="1.0" encoding="UTF-8"?>
<varlink:Interface xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:varlink="https://ingi.dk/varlink" name="io.systemd.NamespaceResource">
  <documentation>Allocate transient UID ranges for user namespace, and assign mounts, cgroups and networking devices to them</documentation>
  <members xsi:type="varlink:EnumDefinition" name="AllocateUserRangeType">
    <documentation>The type of user range allocation to perform.</documentation>
    <body>
      <values name="managed">
        <documentation>Allocate a transient UID/GID range from the dynamic range pool. This is the default.</documentation>
      </values>
      <values name="self">
        <documentation>Create a user namespace that maps the peer UID/GID to itself instead of allocating a transient UID range.</documentation>
      </values>
    </body>
  </members>
  <members xsi:type="varlink:Method" name="AllocateUserRange">
    <documentation>Assigns a UID range to a client-allocated user namespace that has no UID range assigned so far, and registers it for assignment of other resources.</documentation>
    <input>
      <fields name="name">
        <documentation>The name for the user namespace, a short string that must be fit to be included in a file name and in a user name. This name is included in the user records announced via NSS and is otherwise useful for debugging.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="mangleName">
        <documentation>Controls whether to mangle the provided name if needed so that it is suitable for naming a user namespace. If true this will shorten the name as necessary or randomize it if that's not sufficient. If null defaults to false.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="size">
        <documentation>The number of UIDs to assign. Must be 1 or 65536. If type is 'self', must be 1.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="target">
        <documentation>The target UID inside the user namespace. If not specified defaults to 0. If type is 'self', must be 0 or unset in which case the peer UID is mapped to itself.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="userNamespaceFileDescriptor">
        <documentation>A file descriptor to an allocated userns with no current UID range assignments</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="type">
        <documentation>The type of allocation to perform. If 'managed' (the default), a transient UID/GID range is allocated from the dynamic range pool. If 'self', the peer UID/GID is mapped to itself. Defaults to 'managed'.</documentation>
        <type xsi:type="varlink:NamedTypeReference" typeName="AllocateUserRangeType" definition="//@members[name='AllocateUserRangeType']" nullable="true"/>
      </fields>
      <fields name="delegateContainerRanges">
        <documentation>Number of transient 64K container UID/GID ranges to delegate. These are mapped 1:1 into the user namespace and can be used by nested user namespaces for container workloads. Must be between 0 and 16. Defaults to 0.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="mapForeign">
        <documentation>If true, map the foreign UID range 1:1 into the user namespace.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
    </input>
    <output>
      <fields name="name">
        <documentation>The name assigned to the user namespace. (This is particularly interesting in case mangleName was enabled).</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
    </output>
  </members>
  <members xsi:type="varlink:Method" name="RegisterUserNamespace">
    <documentation>Registers an already initialized user namespace for assignment of resources.</documentation>
    <input>
      <fields name="name">
        <documentation>The name for the user namespace, a short string that must be fit to be included in a file name and in a user name, as in AllocateUserRange().</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="mangleName">
        <documentation>Controls whether to mangle the provided name if needed so that it is suitable for naming a user namespace, as in AllocateUserRange()</documentation>
        <type xsi:type="varlink:BuiltinType" kind="bool" nullable="true"/>
      </fields>
      <fields name="userNamespaceFileDescriptor">
        <documentation>A user namespace file descriptor that is fully initialized</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
    </input>
    <output>
      <fields name="name">
        <documentation>The name assigned to the user namespace</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
    </output>
  </members>
  <members xsi:type="varlink:Method" name="AddMountToUserNamespace">
    <documentation>Adds a mount to a user namespace previously allocated or registered via AllocateUserRange() or RegisterUserNamespace(). This allowlists the mount for access by the user namespace.</documentation>
    <input>
      <fields name="userNamespaceFileDescriptor">
        <documentation>A user namespace file descriptor previously allocated via AllocateUserRange() or registered via RegisterUserNamespace().</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="mountFileDescriptor">
        <documentation>A mount file descriptor for the mount to allowlist for the specified user namespace.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
    </input>
    <output/>
  </members>
  <members xsi:type="varlink:Method" name="AddControlGroupToUserNamespace">
    <documentation>Adds a cgroup to a user namespace previously allocated or registered via AllocateUserRange() or RegisterUserNamespace(). This passes ownership of the referenced cgroup to the user namespace's root user, and ensures the cgroup gets deleted when the user namespace is released.</documentation>
    <input>
      <fields name="userNamespaceFileDescriptor">
        <documentation>A user namespace file descriptor previously allocated via AllocateUserRange() or registered via RegisterUserNamespace().</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="controlGroupFileDescriptor">
        <documentation>A file descriptor referencing a cgroup to assign to the root user of the specified user namespace.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
    </input>
    <output/>
  </members>
  <members xsi:type="varlink:Method" name="AddNetworkToUserNamespace">
    <documentation>Adds a network interface to a user namespace previously allocated or registered via AllocateUserRange() or RegisterUserNamespace(). This creates a 'veth' or 'tap' device that is assigned to the user namespace, or owned by its root user.</documentation>
    <input>
      <fields name="userNamespaceFileDescriptor">
        <documentation>A user namespace file descriptor previously allocated via AllocateUserRange() or registered via RegisterUserNamespace().</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int"/>
      </fields>
      <fields name="networkNamespaceFileDescriptor">
        <documentation>A network namespace file descriptor to assign the network interface to. Only applies to network interfaces of type 'veth'.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="namespaceInterfaceName">
        <documentation>The network interface name to use for the network interface inside the network namespace. Only applies to network interfaces of type 'veth'.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="mode">
        <documentation>The networking mode, one of 'veth' or 'tap'. If the former is selected a virtual Ethernet link between host and namespace is created. If the latter is selected an Ethernet Tap link is created and a file descriptor is returned for the namespace side.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
    </input>
    <output>
      <fields name="hostInterfaceName">
        <documentation>The chosen network interface name for the host side of the network.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string"/>
      </fields>
      <fields name="namespaceInterfaceName">
        <documentation>The chosen network interface name for the namespace side of the network. Only applies to network interfaces of type 'veth'.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
      <fields name="interfaceFileDescriptor">
        <documentation>The file descriptor for the namespace side of the network. Only applies to network interfaces of type 'tap'.</documentation>
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
    </output>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="UserNamespaceInterfaceNotSupported">
    <documentation>User namespace delegation via io.systemd.NamespaceResource is not supported.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NameExists">
    <documentation>A user namespace under the specified name exists already.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="UserNamespaceExists">
    <documentation>The specified user namespace has been registered before.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="DynamicRangeUnavailable">
    <documentation>The dynamic UID range is exhausted already.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NoDynamicRange">
    <documentation>The dynamic UID range is not available on this system.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="UserNamespaceNotRegistered">
    <documentation>The specified user namespace has not been registered.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="UserNamespaceWithoutUserRange">
    <documentation>The specified user namespace has no UID range assigned.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="TooManyControlGroups">
    <documentation>The per-user namespace limit of cgroups has been reached.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="ControlGroupAlreadyAdded">
    <documentation>The specified cgroup has already been added to the user namespace.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="TooManyNetworkInterfaces">
    <documentation>The per-user namespace limit of network interfaces has been reached.</documentation>
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="TooManyDelegations">
    <documentation>The specified number of delegations exceeds the maximum allowed.</documentation>
    <parameters/>
  </members>
</varlink:Interface>
