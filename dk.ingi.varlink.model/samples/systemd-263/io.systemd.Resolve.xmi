      <fields name="extendedDNSErrorCode">
        <type xsi:type="varlink:BuiltinType" kind="int" nullable="true"/>
      </fields>
      <fields name="extendedDNSErrorMessage">
        <type xsi:type="varlink:BuiltinType" kind="string" nullable="true"/>
      </fields>
    </parameters>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NoTrustAnchor">
    <parameters/>
