  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NetworkDown">
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="NoSource">
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="StubLoop">
    <parameters/>
  </members>
  <members xsi:type="varlink:ErrorDefinition" name="DNSError">
